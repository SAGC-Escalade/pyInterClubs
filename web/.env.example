# Copier en .env.local et renseigner depuis le dashboard Supabase
# (Project Settings > API). Ne PAS committer .env.local.

# Publiques (exposées au navigateur via le préfixe NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# SECRÈTE — uniquement côté serveur (route handlers). Jamais NEXT_PUBLIC_.
# Sert au provisioning des comptes coach/juge et au recalcul global (cf. doc 10).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
