  <Target Name="Django_migrate_fake" Label="Django - migrate --fake-initial" Returns="@(Commands)">
    <CreatePythonCommandItem TargetType="script" Target="manage.py" Arguments="migrate --fake-initial" WorkingDirectory="$(MSBuildProjectDirectory)" ExecuteIn="output">
      <Output TaskParameter="Command" ItemName="Commands" />
    </CreatePythonCommandItem>
  </Target>
  <Target Name="Django_import" Label="Django - import InterClubs.sqlite" Returns="@(Commands)">
    <CreatePythonCommandItem TargetType="script" Target="manage.py" Arguments="import InterClubs.sqlite" WorkingDirectory="$(MSBuildProjectDirectory)" ExecuteIn="output">
      <Output TaskParameter="Command" ItemName="Commands" />
    </CreatePythonCommandItem>
  </Target>
